# ==============================================================================
# Gitignore for Email Threat Detection & Forensic Analysis Project
# (Python / FastAPI Backend + React.js Frontend + NLP/ML Models)
# ==============================================================================

# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files (Python)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ------------------------------------------------------------------------------
# Virtual Environments & Packaging
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL: Do NOT commit API keys/tokens!)
# Allow .env.example templates to be committed
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.local

# ------------------------------------------------------------------------------
# Unit Tests, Coverage & Pytest
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# Machine Learning, NLP & BERT Caches / Model Weights
# (Avoid committing massive weights/checkpoints; pull dynamically or from cache)
# ------------------------------------------------------------------------------
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.h5
*.pkl
models/downloaded/
huggingface/
.transformers_cache/
.torch/

# ------------------------------------------------------------------------------
# Frontend (Node / React / Vite / Next.js)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
dist/
build/
.npm
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Editors & IDEs
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.directory

# ------------------------------------------------------------------------------
# OS-Generated Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
run/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.lock

