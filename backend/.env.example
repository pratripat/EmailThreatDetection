# Email Threat Forensics & Intelligence Backend Environment Configuration

# Threat Intelligence API Keys (Optional - runs in bounded offline mode if omitted)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_API_KEY=

# Intelligence Feature Toggles
ENABLE_DNSBL=false
ENABLE_RDAP=true
ENABLE_LIVE_INTELLIGENCE=false

# Timeouts and Limits
REQUEST_TIMEOUT_SECONDS=3.0
MAX_REDIRECTS=5
MAX_REDIRECT_BYTES=8192

# Cache Configuration
CACHE_TTL_SECONDS=3600
MAX_CACHE_ENTRIES=1000

# Machine Learning / NLP Classifier
EMAIL_MODEL_PATH=
USE_GPU_FOR_INFERENCE=false

# Data Directory
SIH_DATA_DIR=backend/data
